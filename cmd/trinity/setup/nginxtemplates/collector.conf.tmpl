# Trinity collector nginx vhost. Rendered by setup.RenderCollectorNginxConfig
# and installed by scripts/bootstrap-nginx.sh --mode=collector. Carries:
#   - HTTP→HTTPS redirect for {{ .PublicHost }}
#   - HTTPS server with /demos/, /assets/levelshots/, /demopk3s/ that
#     the hub's WASM engine loader 302s to (CORS wildcard required)
#   - dl.{{ .PublicHost }} fastdl vhost (HTTP + HTTPS)
#
# Cert paths assume Let's Encrypt's standard layout. The wizard arranges
# for /etc/letsencrypt/live/{{ .PublicHost }}/ to exist before nginx is
# (re)loaded with this config. SAN cert covers both {{ .PublicHost }}
# and dl.{{ .PublicHost }}.

server {
    listen 80;
    listen [::]:80;
    server_name {{ .PublicHost }};
    return 301 https://$host$request_uri;
}

server {
    listen [::]:443 ssl ipv6only=on;
    listen 443 ssl;
    server_name {{ .PublicHost }};

    ssl_certificate     /etc/letsencrypt/live/{{ .PublicHost }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ .PublicHost }}/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;

    root {{ .StaticDir }};

    # Recorded demos: the hub's WASM engine loader fetches these
    # cross-origin, so wildcard CORS is required. They are written once
    # under UUID names, so cache forever.
    location /demos/ {
        autoindex off;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Access-Control-Allow-Origin "*" always;
    }

    # Map levelshots, with CORS so scripts can read them too.
    location /assets/levelshots/ {
        autoindex off;
        expires 30d;
        add_header Cache-Control "public";
        add_header Access-Control-Allow-Origin "*" always;
    }

    # Map pk3s from demobake, fetched cross-origin by the engine loader.
    location /demopk3s/ {
        autoindex off;
        add_header Access-Control-Allow-Origin "*" always;
    }

    # TrinityVision live: the hub redirects viewers here (one bare segment,
    # no extension). Proxies to the local relay with buffering off, so nginx
    # adds no delay of its own.
    location ~ ^/tv/[^/]+$ {
        proxy_pass http://127.0.0.1:8081;
        proxy_buffering off;
        # The live relay can go >60s without bytes (intermission, engine stall);
        # mirror the /ws block so nginx's default 60s timeout doesn't 504 the
        # viewer mid-match.
        proxy_http_version 1.1;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        add_header Access-Control-Allow-Origin "*" always;
    }

    # Everything else: this isn't an app, return 404.
    location / {
        return 404;
    }
}

# Quake III fast downloads.
server {
    listen 80;
    listen [::]:80;
    server_name dl.{{ .PublicHost }};

    root {{ .Quake3Dir }};

    location ~ ^/(baseq3|missionpack)/pak0\.pk3$ {
        return 403;
    }
    location ~ \.(pk3|tvd)$ {
        try_files $uri =404;
    }
    location / {
        return 403;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name dl.{{ .PublicHost }};

    ssl_certificate     /etc/letsencrypt/live/{{ .PublicHost }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ .PublicHost }}/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;

    root {{ .Quake3Dir }};

    location ~ ^/(baseq3|missionpack)/pak0\.pk3$ {
        return 403;
    }
    location ~ \.(pk3|tvd)$ {
        try_files $uri =404;
    }
    location / {
        return 403;
    }
}
