[Unit]
Description=Trinity Discord weekly leaderboard digest
# The digest reads the hub's local HTTP API, so it runs only while the
# hub is up. With the hub stopped it skips, so it never posts an empty week.
After=trinity.service network-online.target
Requires=trinity.service

[Service]
Type=oneshot
User=quake
Group=quake
ExecStart=/usr/local/bin/trinity discord-digest --period week

# Sandboxing: the digest reads /etc/trinity/config.yml, makes one
# outbound HTTPS POST and writes no files.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
