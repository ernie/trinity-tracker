[Unit]
Description=Trinity
# Starts before quake3-servers.target, whose game servers have
# After=trinity.service. The log tailer waits for each server's log
# file to appear.
After=network.target
Before=quake3-servers.target

[Service]
Type=simple
User=quake
Group=quake
ExecStart=/usr/local/bin/trinity serve
Restart=on-failure
RestartSec=5

# Sandboxing: Trinity reads /etc/trinity and /var/log/quake3, and writes
# /var/lib/trinity (the SQLite database and NATS state).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/trinity
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
