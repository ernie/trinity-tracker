[Unit]
Description=Quake 3 %i
After=network-online.target trinity.service
Wants=network-online.target
PartOf=quake3-servers.target

[Service]
Type=simple
User=quake
WorkingDirectory=/usr/lib/quake3
EnvironmentFile=-/etc/trinity/%i.env
# fs_multiuser 0 keeps home path == base path (the engine default is a
# per-user ~/.trinity); both then resolve to WorkingDirectory above, so
# that line is load-bearing — don't drop it.
ExecStart=/usr/lib/quake3/trinity.ded +set fs_multiuser 0 +set com_hunkmegs 256 +set g_log "logs/%i.log" $SERVER_OPTS
TimeoutStopSec=30
Restart=on-failure

[Install]
WantedBy=quake3-servers.target
